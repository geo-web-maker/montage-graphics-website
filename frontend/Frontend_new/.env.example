# Use / on Vercel or any dedicated domain; /montage/ only when served under /montage.
VITE_BASE_PATH=/
# Set to /montage for same-origin hosting, or https://api.example.com/montage for a separate frontend host.
VITE_API_URL=/montage

# Cloudflare Turnstile site key (public). Dev/test keys: 1x00000000000000000000AA (always pass),
# 2x00000000000000000000AB (always block). Leave empty to disable the widget locally.
VITE_TURNSTILE_SITE_KEY=
